# ── ASIAPLAST environment configuration ────────────────────────────────
# Copy to .env.local for development. Never commit real secrets.

# Canonical public URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://asiaplast.web.app

# Firebase web app config — project ajansonline (console.firebase.google.com)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ajansonline.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ajansonline
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=ajansonline.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Public export desk (shown on the contact page)
NEXT_PUBLIC_CONTACT_EMAIL=export@asiaplast.com
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_COUNTRY=Turkey

# Google Analytics 4 measurement ID (optional; empty disables GA)
NEXT_PUBLIC_GA_ID=

# Admin desk login (required for /admin). Never hardcode these in source.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional. Default is "admin". Set "admin,superadmin" for the operator badge.
ADMIN_ROLES=admin

# Admin session signing secret — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=

# Admin session lifetime in hours (default 12)
ADMIN_SESSION_TTL_HOURS=12

# Server-side Firebase credentials (choose ONE for local dev):
# 1) Service account JSON file path:
GOOGLE_APPLICATION_CREDENTIALS=
# 2) Or the full JSON as a single-line env var (takes precedence):
FIREBASE_SERVICE_ACCOUNT_JSON=
