{
    "name": "asiaplast",
    "version": "1.0.0",
    "private": true,
    "description": "ASIAPLAST — Global garbage bags manufacturer & exporter. Multilingual B2B website, RFQ engine and Firebase-powered admin dashboard.",
    "scripts": {
        "dev": "next dev -p 3000",
        "build": "next build",
        "start": "next start -p 3000",
        "typecheck": "tsc --noEmit",
        "seed": "tsx scripts/seed-products.ts",
        "admin:set": "tsx scripts/set-admin.ts",
        "check:storage": "node scripts/check-no-storage.mjs",
        "clean:hosting": "node scripts/cleanup-hosting-releases.mjs --execute",
        "clean:hosting:check": "node scripts/cleanup-hosting-releases.mjs --dry-run"
    },
    "dependencies": {
        "firebase-admin": "^14.5.0",
        "next": "^14.2.35",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "server-only": "^0.0.1",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/node": "^20.14.11",
        "@types/react": "^18.3.3",
        "@types/react-dom": "^18.3.0",
        "autoprefixer": "^10.4.19",
        "postcss": "^8.4.39",
        "tailwindcss": "^3.4.6",
        "tsx": "^4.16.2",
        "typescript": "^5.5.3"
    },
    "engines": {
        "node": "20"
    }
}
