{
    "name": "asiaplast",
    "version": "1.0.0",
    "private": true,
    "description": "ASIAPLAST — Global garbage bags manufacturer & exporter. Multilingual B2B website, RFQ engine and Firebase-powered admin dashboard.",
    "scripts": {
        "dev": "next dev -H 127.0.0.1 -p 3000",
        "build": "next build",
        "start": "next start -H 127.0.0.1 -p 3000",
        "typecheck": "tsc --noEmit",
        "seed": "tsx scripts/seed-products.ts",
        "admin:set": "tsx scripts/set-admin.ts",
        "check:storage": "node scripts/check-no-storage.mjs",
        "cleanup:hosting:dry": "node scripts/cleanup-hosting-versions.mjs --site=asiaplast",
        "cleanup:hosting": "node scripts/cleanup-hosting-versions.mjs --apply --site=asiaplast",
        "deploy:hosting": "node -e \"process.env.NODE_OPTIONS='--require ./scripts/win-symlink-shim.cjs'; require('child_process').execFileSync(process.platform==='win32'?'firebase.cmd':'firebase', ['deploy', '--only', 'storage,hosting:asiaplast', '--project', 'ajansonline'], {stdio:'inherit', shell:process.platform==='win32'})\""
    },
    "dependencies": {
        "firebase-admin": "^13.10.0",
        "next": "^14.2.35",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/node": "^20.14.11",
        "@types/react": "^18.3.3",
        "@types/react-dom": "^18.3.0",
        "autoprefixer": "^10.4.19",
        "postcss": "^8.4.39",
        "tailwindcss": "^3.4.6",
        "tsx": "^4.16.2",
        "typescript": "^5.5.3"
    },
    "engines": {
        "node": "22"
    }
}