{
    "hosting": {
        "target": "asiaplast",
        "source": ".",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**",
            "asiaplast_global_portal_real_time_management_dashboard.html",
            "README.md"
        ],
        "frameworksBackend": {
            "region": "europe-west1",
            "maxInstances": 10,
            "minInstances": 0
        },
        "postdeploy": [
            "node scripts/cleanup-hosting-versions.mjs --apply"
        ]
    },
    "firestore": {
        "rules": "firestore.rules",
        "indexes": "firestore.indexes.json"
    },
    "storage": {
        "rules": "storage.rules"
    },
    "emulators": {
        "auth": {
            "port": 9099
        },
        "firestore": {
            "port": 8080
        },
        "hosting": {
            "port": 5000
        },
        "ui": {
            "enabled": true
        }
    }
}